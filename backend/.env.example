DJANGO_SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL é o banco de todos os ambientes — não existe fallback para SQLite.
# O valor abaixo aponta para a porta que o docker-compose publica no host (5435).
# Dentro do Compose, o "environment:" do serviço tem precedência e usa o host
# interno `postgres:5432`, então estas linhas não interferem nos containers.
DATABASE_URL=postgres://pelada:pelada@localhost:5435/pelada

# Banco usado pela suíte de testes (o pytest-django cria e destrói `test_pelada`).
# Também em PostgreSQL de propósito: testar em SQLite e rodar em Postgres esconde
# diferenças reais de constraint, tipo e transação.
TEST_DATABASE_URL=postgres://pelada:pelada@localhost:5435/pelada

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173

DRAW_PAIRING_HISTORY_WINDOW=10
