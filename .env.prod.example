# Variáveis de produção. Copie para `.env.prod` no servidor e preencha.
#
#   cp .env.prod.example .env.prod
#
# O `.env.prod` **não** vai para o git (está no .gitignore) e **não** entra na
# imagem (está no .dockerignore) — o compose o lê do disco do servidor.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Gere uma chave nova e exclusiva deste servidor. Nunca reaproveite a do
# desenvolvimento — ela assina os tokens de sessão e o reset de senha:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

DJANGO_SETTINGS_MODULE=config.settings.prod
# `localhost` e `127.0.0.1` entram junto com o dominio, e nao por descuido: o
# healthcheck do container chama a si mesmo por `http://localhost:8000/`, e sem
# eles o Django responde 400 DisallowedHost. O container fica `unhealthy` para
# sempre e o worker e o beat do Celery nem sobem, porque dependem dele. Os dois
# so sao alcancaveis de dentro da maquina, entao nao ampliam a superficie.
DJANGO_ALLOWED_HOSTS=peakyblindersbaba.datadata.com.br,localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Sao_Paulo

# Exigido pelo Django para aceitar POST no /admin/ atrás de proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=https://peakyblindersbaba.datadata.com.br

# Deixe comentado (o padrão é True). Só ligue em False enquanto o certificado
# ainda não existir — com HTTPS no ar, False deixa o site aceitar http puro.
# DJANGO_SECURE_SSL_REDIRECT=False

# O SPA e a API saem do mesmo domínio, então o navegador nem faz requisição
# cross-origin. A lista existe porque `prod.py` a exige; manter o próprio
# domínio aqui é o mais restritivo que dá.
CORS_ALLOWED_ORIGINS=https://peakyblindersbaba.datadata.com.br

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
POSTGRES_DB=pelada
POSTGRES_USER=pelada
# Senha longa e aleatória — este banco guarda telefones e o financeiro:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# `postgres` e `redis` são os nomes dos serviços na rede do compose, não
# `localhost`: de dentro do container, localhost é o próprio container.
DATABASE_URL=postgres://pelada:SENHA_IGUAL_A_DE_CIMA@postgres:5432/pelada

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Limites de requisição
# ---------------------------------------------------------------------------
# Os padrões do `base.py` servem. Descomente só se a pelada crescer a ponto de
# esbarrar neles.
# THROTTLE_RATE_USER=2000/hour
# THROTTLE_RATE_ANON=120/hour
# THROTTLE_RATE_LOGIN=20/minute

DRAW_PAIRING_HISTORY_WINDOW=10
